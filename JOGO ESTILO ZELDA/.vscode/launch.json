    "version": "0.2.0",
    "configurations": [
        {
            "name": "Open index.html in Edge",
            "type": "pwa-msedge",
            "request": "launch",
            "file": "${workspaceFolder}/index.html",
            "webRoot": "${workspaceFolder}",
            "runtimeExecutable": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
            "userDataDir": "${workspaceFolder}/.vscode/edge-profile"
        },
        {
            "name": "Open index.html in Chrome",
            "type": "pwa-chrome",
            "request": "launch",
            "file": "${workspaceFolder}/index.html",
            "webRoot": "${workspaceFolder}",
            "userDataDir": "${workspaceFolder}/.vscode/chrome-profile"
        },
        {
            "name": "Open index.html in Vivaldi",
            "type": "pwa-chrome",
            "request": "launch",
            "file": "${workspaceFolder}/index.html",
            "webRoot": "${workspaceFolder}",
            "runtimeExecutable": "C:\\Users\\biele\\AppData\\Local\\Vivaldi\\Application\\vivaldi.exe",
            "userDataDir": "${workspaceFolder}/.vscode/vivaldi-profile"
        }
    ]
}